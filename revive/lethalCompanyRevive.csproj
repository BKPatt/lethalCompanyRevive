<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>annotations</Nullable>
    </PropertyGroup>

    <!-- Override any of these on the command line (dotnet build -p:GameDir=...) if your paths differ. -->
    <PropertyGroup>
        <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Lethal Company</GameDir>
        <ManagedDir>$(GameDir)\Lethal Company_Data\Managed</ManagedDir>
        <ProfileDir Condition="'$(ProfileDir)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\LethalCompany\profiles\Newer</ProfileDir>
        <BepInExDir>$(ProfileDir)\BepInEx</BepInExDir>
        <DeployDir Condition="'$(DeployDir)' == ''">$(BepInExDir)\plugins\Unknown-lethalCompanyRevive</DeployDir>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\.editorconfig" Link=".editorconfig" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="InteractiveTerminalAPI"><HintPath>$(BepInExDir)\plugins\WhiteSpike-Interactive_Terminal_API\InteractiveTerminalAPI\InteractiveTerminalAPI.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="LethalLib"><HintPath>$(BepInExDir)\plugins\Evaisa-LethalLib\LethalLib\LethalLib.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Unity.InputSystem"><HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Unity.Netcode.Runtime"><HintPath>$(ManagedDir)\Unity.Netcode.Runtime.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.AIModule"><HintPath>$(ManagedDir)\UnityEngine.AIModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.InputModule"><HintPath>$(ManagedDir)\UnityEngine.InputModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    </ItemGroup>

    <!--
        RPCs only work after NetcodePatcher rewrites them. The versions must match the game's
        Netcode for GameObjects package and Unity version (check Managed\Unity.Netcode.Runtime.dll
        for "com.unity.netcode.gameobjects@x.y.z" after a game update).
        Install with: dotnet tool install -g Evaisa.NetcodePatcher.Cli
    -->
    <PropertyGroup>
        <NetcodeVersion>1.12.2</NetcodeVersion>
        <TransportVersion>1.0.0</TransportVersion>
        <UnityVersion>2022.3.62</UnityVersion>
        <!-- The game ships Transport 1.5.0, but NetcodePatcher only bundles 1.0.0 and it does not affect RPC codegen. -->
    </PropertyGroup>

    <Target Name="NetcodePatch" AfterTargets="PostBuildEvent">
        <Exec Command="netcode-patch -nv $(NetcodeVersion) -tv $(TransportVersion) -uv $(UnityVersion) &quot;$(TargetPath)&quot; @(ReferencePathWithRefAssemblies->'&quot;%(Identity)&quot;', ' ')" />
    </Target>

    <!-- Opt-in: dotnet build -p:Deploy=true copies the plugin into the mod manager profile for local testing.
         Leave it off when the profile has the Thunderstore version installed, or you'll load two copies. -->
    <Target Name="Deploy" AfterTargets="NetcodePatch" Condition="'$(Deploy)' == 'true' And Exists('$(BepInExDir)')">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    </Target>
</Project>
